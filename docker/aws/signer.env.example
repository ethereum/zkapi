# Private challenge-signer settings. Install as /etc/zkapi/signer.env, owned by
# root with mode 0600. Only the signer container reads this file; keep the key
# out of every other environment file. See signer/README.md.
ZKAPI_CHALLENGE_PRIVATE_KEY=REPLACE_WITH_DEDICATED_SENDER_PRIVATE_KEY
ZKAPI_CHALLENGE_CHAIN_ID=11155111
ZKAPI_CHALLENGE_RPC_URL=https://REPLACE_WITH_UPSTREAM_RPC_FOR_THE_CHAIN
ZKAPI_CHALLENGE_VAULT=REPLACE_WITH_VAULT_ADDRESS

# EIP-1559 fee cap in wei: the highest maxFeePerGas the signer signs. Required
# when ZKAPI_CHALLENGE_CHAIN_ID=1 (Sepolia defaults to 10 gwei). Choose at least
# the worst base fee to survive x 1.125 + the tip, and keep gas limit x fee cap
# within the transaction fee cap below. The placeholder is refused.
ZKAPI_CHALLENGE_MAX_FEE_PER_GAS_WEI=REPLACE_WITH_FEE_CAP_WEI

# Optional, shown with their defaults (positive decimal integers; empty = default).
# Tip of a bid made without proposed fees: min(1 gwei, tip cap).
#ZKAPI_CHALLENGE_PRIORITY_FEE_PER_GAS_WEI=1000000000
# Highest tip the signer signs: min(fee cap, 10 x the default tip).
#ZKAPI_CHALLENGE_MAX_PRIORITY_FEE_PER_GAS_WEI=10000000000
# Typo guard for the fee cap: 10,000 gwei, at most 1,000,000 gwei.
#ZKAPI_CHALLENGE_FEE_CEILING_WEI=10000000000000
# Highest gas limit x maxFeePerGas the signer signs: set it to the upstream
# node's --rpc.txfeecap (geth and reth default to 1 ETH), which refuses larger
# transactions. At 1 ETH a 600,000-gas defeat can bid about 1,666 gwei and a
# 7.2M-gas leaf retirement about 138.9 gwei. Raise it only together with the
# node's cap. The challenger reads its own copy from deployment.env; set the
# same value there.
#ZKAPI_CHALLENGE_TX_FEE_CAP_WEI=1000000000000000000
# Gas limit cap: keep a margin above the largest call the challenger makes, a
# leaf retirement of about 7.2M gas (8M is a good value). Status warns
# tx_fee_cap_below_fee_cap while MAX_GAS x fee cap exceeds the transaction fee
# cap, even when the real calls still fit; see signer/README.md.
#ZKAPI_CHALLENGE_MAX_GAS=12000000
# Nonces on which the signer signs a leaf retirement (about 6M gas each, only
# after a missed defeat, whether it retires the leaf or reverts) per rolling 24
# hours; fee replacements on a counted nonce are free, and 0 refuses every
# retirement. Bounds what a compromised challenger host can spend on closed
# notes. A decimal integer from 0 to 1000; empty = the default.
#ZKAPI_CHALLENGE_MAX_RETIREMENTS_PER_DAY=2
# The operator's retire-on-miss policy (design §5.4): keep it equal to the
# challenger's ZKAPI_CHALLENGE_RETIRE_ON_MISS in deployment.env; false refuses
# every leaf retirement. A retirement is signed only for a note whose escape
# finalized (EscapeWithdrawalFinalized) within the lookback (blocks, 1 to
# 5,000,000; default about 7 days of 12 s blocks).
#ZKAPI_CHALLENGE_RETIRE_ON_MISS=true
#ZKAPI_CHALLENGE_RETIREMENT_LOOKBACK_BLOCKS=50400

# Funding: hold at least (N + K) x gas limit x fee cap, where N is the number of
# transactions that may be pending at once and K a budget of reverted attempts.
# At a 100 gwei cap a defeat (600,000 gas) reserves 0.06 ETH and a leaf
# retirement (about 7.2M gas) about 0.72 ETH. ZKAPI_CHALLENGE_MAX_GAS_PRICE_WEI is no longer supported; the
# signer refuses to start while it is present.
