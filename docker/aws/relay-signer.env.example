# Private close-relay signer settings (docs/native-eth-billing.md, "Close
# relay"). Install as /etc/zkapi/relay-signer.env, owned by root with mode 0600,
# for the relay-signer service (compose profile "relay"). compose.yml sets
# ZKAPI_SIGNER_ROLE=close-relay and port 8548. Use a key of its own: never the
# challenger's, so the relay can never spend the challenger's float, and the
# challenger's signer refuses every relay call (and this one every challenger
# call). The variables keep their ZKAPI_CHALLENGE_ names; see signer/README.md.
ZKAPI_CHALLENGE_PRIVATE_KEY=REPLACE_WITH_DEDICATED_RELAYER_PRIVATE_KEY
ZKAPI_CHALLENGE_CHAIN_ID=11155111
ZKAPI_CHALLENGE_RPC_URL=https://REPLACE_WITH_UPSTREAM_RPC_FOR_THE_CHAIN
ZKAPI_CHALLENGE_VAULT=REPLACE_WITH_VAULT_ADDRESS
# Required in this role: the manifest's exit_batcher_address. Startup fails
# unless its vault() is ZKAPI_CHALLENGE_VAULT.
ZKAPI_CHALLENGE_EXIT_BATCHER=REPLACE_WITH_EXIT_BATCHER_ADDRESS
# The fee cap: at least serverd's --relay-max-fee-per-gas
# (ZKAPI_RELAY_MAX_FEE_PER_GAS), which the relay never exceeds. Required on
# chain 1.
ZKAPI_CHALLENGE_MAX_FEE_PER_GAS_WEI=REPLACE_WITH_FEE_CAP_WEI

# Optional, with their defaults in this role.
# The most closes of a signed batch: 64 (1 to 64); keep it at least serverd's
# --relay-max-batch.
#ZKAPI_CHALLENGE_BATCH_MAX_ITEMS=64
# Gas limit cap: at least serverd's --relay-max-gas (both 12M by default, which
# carries 32 closes at a 150,000 cap with room to spare; raise both together for
# larger batches, up to 16,777,216).
#ZKAPI_CHALLENGE_MAX_GAS=12000000
#ZKAPI_CHALLENGE_PRIORITY_FEE_PER_GAS_WEI=1000000000
#ZKAPI_CHALLENGE_MAX_PRIORITY_FEE_PER_GAS_WEI=10000000000
#ZKAPI_CHALLENGE_TX_FEE_CAP_WEI=1000000000000000000
