# Private activation-signer settings. Install as /etc/zkapi/activation-signer.env,
# owned by root with mode 0600. Only the activation-signer container reads this
# file; Compose sets ZKAPI_SIGNER_PROFILE=activation for it. It signs only the
# activation worker's activateNotes calls to the vault. Use a key of its own:
# never the challenge signer's (signer.env), whose variables, prefixed
# ZKAPI_CHALLENGE_, this signer refuses. Its sender must be the vault's
# activator: Deploy.s.sol's ACTIVATOR, or the address the owner names with
# setActivator, which must then also be recorded as the activator of
# deployment.json and of the finalized manifest that profiles are regenerated
# from. The vault refuses activateNotes from anyone else, and status warns
# sender_not_activator (or activator_unreadable while the vault's activator()
# cannot be read). See signer/README.md.
ZKAPI_ACTIVATION_PRIVATE_KEY=REPLACE_WITH_DEDICATED_ACTIVATION_SENDER_PRIVATE_KEY
ZKAPI_ACTIVATION_CHAIN_ID=11155111
ZKAPI_ACTIVATION_RPC_URL=https://REPLACE_WITH_UPSTREAM_RPC_FOR_THE_CHAIN
ZKAPI_ACTIVATION_VAULT=REPLACE_WITH_VAULT_ADDRESS

# EIP-1559 fee cap in wei: the highest maxFeePerGas the signer signs. Required
# when ZKAPI_ACTIVATION_CHAIN_ID=1 (Sepolia defaults to 10 gwei). Activation
# has no deadline: a base fee above the cap only delays it. The placeholder is
# refused.
ZKAPI_ACTIVATION_MAX_FEE_PER_GAS_WEI=REPLACE_WITH_FEE_CAP_WEI

# Optional, shown with their defaults (positive decimal integers; empty = default).
# Tip of a bid made without proposed fees: min(1 gwei, tip cap).
#ZKAPI_ACTIVATION_PRIORITY_FEE_PER_GAS_WEI=1000000000
# Highest tip the signer signs: min(fee cap, 10 x the default tip).
#ZKAPI_ACTIVATION_MAX_PRIORITY_FEE_PER_GAS_WEI=10000000000
# Typo guard for the fee cap: 10,000 gwei, at most 1,000,000 gwei.
#ZKAPI_ACTIVATION_FEE_CEILING_WEI=10000000000000
# Highest gas limit x maxFeePerGas the signer signs: the upstream node's
# --rpc.txfeecap (geth and reth default to 1 ETH). At 1 ETH a 726,000-gas
# activation of 16 notes can bid about 1,377 gwei.
#ZKAPI_ACTIVATION_TX_FEE_CAP_WEI=1000000000000000000
# Gas limit cap: an activation takes about 286,000 gas for 1 note, 348,000 for
# 4 and 605,000 for 16, and the worker's gas limit is its estimate plus 20%
# (726,000 for 16 notes).
#ZKAPI_ACTIVATION_MAX_GAS=1000000

# Funding: the worker keeps one transaction pending at a time; hold at least
# gas limit x fee cap for it (about 0.075 ETH for a 16-note activation at a
# 100 gwei cap, the worker's default low-balance warning) plus the activations expected before the next top-up. Status warns
# balance_below_required below ZKAPI_ACTIVATION_MAX_GAS x fee cap.
