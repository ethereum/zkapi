# Public deployment metadata; replace all placeholders with the fresh deployment.
CIRCUIT_ID=zkapi-v2-concession-v1
CHAIN_ID=11155111
VAULT_ADDRESS=REPLACE_WITH_FRESH_VAULT_ADDRESS
DEPLOY_BLOCK=REPLACE_WITH_VAULT_DEPLOYMENT_BLOCK
REQUEST_CHARGE_CAP=50000
LEASE_TTL_SECONDS=300
SETTLEMENT_GRACE_SECONDS=5
# Write-once lease settlement deadline, counted from issuance + TTL + grace. A
# lease still unsettled then is finalized at its measured usage or, failing
# that, at its proof's solvency bound, and recorded for operator review. The
# server refuses to start unless LEASE_TTL_SECONDS + SETTLEMENT_GRACE_SECONDS +
# this + 2 x the 2-second settlement poll + 600 <= the vault's challengePeriod / 2,
# and unless this is at least SETTLEMENT_GRACE_SECONDS + 900. Use 14400 on
# Sepolia (challengePeriod 43,200), 21600 on Mainnet (172,800) and 1800 for the
# Sepolia drill (7,200): LEASE_TTL_SECONDS + SETTLEMENT_GRACE_SECONDS + this is
# the manifest's settlement_window_seconds (14,705, 21,905 and 2,105), which
# neither the server nor the challenger may exceed.
ZKAPI_OPENROUTER_SETTLEMENT_DEADLINE_SECONDS=14400
CHALLENGE_CONFIRMATIONS=2
# The challenger raises an escape's concession to what the server is owed by
# the escape's deadline minus this many seconds at the latest, when the charge
# is not settled earlier: 21600 on Mainnet and Sepolia, 1800 for the drill. It
# refuses to start unless LEASE_TTL_SECONDS + SETTLEMENT_GRACE_SECONDS +
# ZKAPI_OPENROUTER_SETTLEMENT_DEADLINE_SECONDS + this + 4 x 2 + 1200 <=
# challengePeriod (Sepolia: 37,513 <= 43,200).
ZKAPI_CHALLENGE_RAISE_LEAD_SECONDS=21600
# Smallest raise worth its gas, in gwei; 0 raises every shortfall.
#ZKAPI_CHALLENGE_RAISE_MIN_UNITS=0
# After a missed defeat (the escape was paid out although the server held a
# successor's request), retire the closed note's leaf with retireClosedLeaf
# (about 6M gas). Default true. Set the same value in signer.env, whose signer
# refuses every retirement when it is false.
#ZKAPI_CHALLENGE_RETIRE_ON_MISS=true
# Transaction fee cap of the challenge signer and challenger, shared by both:
# the highest gas limit x maxFeePerGas of one transaction, in decimal wei. Set
# it to the --rpc.txfeecap of the node behind the signer (geth and reth default
# to 1 ETH, which allows about 1,666 gwei for a 600,000-gas defeat and about
# 138 gwei for a 7.2M-gas leaf retirement). The challenger reads it here and
# bids within the lower of it and the signer's value; the signer reads only
# signer.env, so set the same value there. Raise it only together with the
# node's cap.
ZKAPI_CHALLENGE_TX_FEE_CAP_WEI=1000000000000000000
# Blocks a vault event must be buried before the indexer checkpoints it. The
# served tree still tracks the verified head.
INDEXER_CONFIRMATIONS=12
# Seconds the RPC head block may age before the indexer answers 503. 0 disables
# the check; use it only on chains that mine on demand (anvil).
INDEXER_MAX_HEAD_AGE_SECS=180
RUST_LOG=info
# Set only for verifier-backed OA-org leases (mutually exclusive with a direct
# OpenRouter management credential in server.env).
# OA_ORG_URL=https://org.example

# Mutual-close clearance requires a kind-2 ownership proof on this circuit:
# serverd refuses to start with ZKAPI_ALLOW_LEGACY_CLEARANCE=true.
# How long a Merkle root the server saw stays acceptable for an ownership proof
# (60 to 86400 seconds).
# ZKAPI_CLEARANCE_ROOT_WINDOW_SECONDS=3600
# Admission refuses requests (retriable root_unavailable) unless the indexer
# root and the vault's currentRoot() agreed at most this many seconds ago.
# ZKAPI_ROOT_MAX_STALENESS_SECONDS=60
# The operator's per-request exposure ceiling, in micro-USD of lease budget:
# a request whose proof-bound budget exceeds it is refused before anything is
# reserved. $6 during the canary, and recommended permanently.
ZKAPI_REQUEST_LIMIT_MAX_USD_MICROS=6000000

# Native ETH ledger: integer gwei. Pin the feed/RPC to the selected chain. The
# server also reads the vault's signing keys and challengePeriod(), runs its
# startup probes (vault, adapter and Poseidon library against deployment.json),
# polls currentRoot() and reads usedNullifiers()/challengedNullifiers() over
# this RPC, so it must serve CHAIN_ID.
ZKAPI_NATIVE_BILLING_RPC_URL=REPLACE_WITH_CHAIN_RPC_URL
ZKAPI_NATIVE_PRICE_FEED_ADDRESS=REPLACE_WITH_CHAIN_ETH_USD_FEED
ZKAPI_NATIVE_PRICE_FEED_DECIMALS=8
# Must equal the published manifest's native_price_max_age_seconds. A change
# applies to new leases; accepted leases settle with their saved quote. A wallet
# request journaled but never admitted under the old value is refused until its
# quote expires, then retired by clients from this release (see
# docs/native-eth-billing.md).
ZKAPI_NATIVE_PRICE_MAX_AGE_SECONDS=4500
