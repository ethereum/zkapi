{
  "name": "@openanonymity/zkapi-browser-sdk",
  "version": "0.2.0",
  "private": true,
  "description": "Browser wallet, proofs, key lifecycle and withdrawals for zkAPI",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:browser",
    "build:browser": "node scripts/build-sdk.mjs --network sepolia",
    "build:mainnet": "node scripts/build-sdk.mjs --network mainnet",
    "test": "npm run test:sdk",
    "test:sdk": "node --test sdk/test/*.test.mjs",
    "test:e2e:v2": "bash scripts/run-v2-acceptance.sh",
    "verify:assets": "node scripts/sync-sdk-assets.mjs --check",
    "verify:wasm": "bash scripts/build-browser-client.sh --check",
    "verify:builds": "node scripts/check-sdk-builds.mjs"
  },
  "devDependencies": {
    "esbuild": "0.27.2"
  },
  "files": [
    "sdk/"
  ],
  "exports": {
    ".": "./sdk/index.js",
    "./configure": "./sdk/configure.js",
    "./client": "./sdk/services/zkapiClient.js",
    "./runtime": "./sdk/services/browserWalletRuntime.js",
    "./store": "./sdk/services/browserWalletStore.js",
    "./wallet": "./sdk/wallet.js",
    "./build": "./sdk/build.mjs",
    "./request-compat": "./sdk/services/zkapiRequestCompat.mjs",
    "./withdrawal-recovery": "./sdk/services/zkapiWithdrawalRecovery.mjs",
    "./expiry-history": "./sdk/services/zkapiExpiryHistory.mjs",
    "./withdrawal-root": "./sdk/services/zkapiWithdrawalRoot.mjs",
    "./request-archive": "./sdk/services/zkapiRequestArchive.mjs",
    "./exit-kit": "./sdk/services/zkapiExitKit.mjs",
    "./gas": "./sdk/services/zkapiGas.mjs",
    "./gasless": "./sdk/services/zkapiGasless.mjs",
    "./contract-error": "./sdk/services/zkapiContractError.mjs",
    "./wallet-error": "./sdk/services/zkapiWalletError.mjs",
    "./package.json": "./package.json"
  }
}
