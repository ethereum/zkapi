import ZkapiPoC.Embed
import ZkapiPoC.Data
import ZkapiFormal.Yul.Permute

/-! # Proof of concept: `compress` end to end, for all calldata

`PoseidonFallback.sol` (generated by `gen_fallback.py`) is a contract whose runtime is, after
solc's `mstore(0x40, 0x80)` prologue, one inline-assembly block: the unrolled permutation as a Yul
function (its body is the production runtime's `permute` body, verbatim), the ABI check and a
one-entry dispatcher for `compress(uint256,uint256,uint256)`. `poc_compress` states what that
block does for **every** calldata (any length and contents) and any initial memory, assuming only
that the calldata is shorter than `2^48` bytes:

* fewer than 4 bytes: `revert(0, 0)`;
* selector `0x2d0c7694` with fewer than `4 + 96` bytes: `revert(0, 0)`;
* selector `0x2d0c7694`: `return` of the 32-byte big-endian encoding of
  `compressWord w₄ w₃₆ w₆₈`, the words of calldata at offsets 4, 36, 68 (zero-padded), which is
  `(Poseidon.compress w₄ w₃₆ w₆₈).val` (`compressWord_eq`), for all words, canonical or not;
* any other selector: `revert(0, 0)`.

The kernel parses the block from its tokens (`pocOK_source`); the permutation part reuses the
`Zkapi.Yul` proofs through `execL_unemb`. -/

namespace Zkapi.PoC

open Zkapi.Lazy (wordPermute compressWord program)

/-! ## Structural equality of statements -/

mutual
def beqE : Expr → Expr → Bool
  | .lit a, .lit b => a == b
  | .var a, .var b => a == b
  | .call f as, .call g bs => f == g && beqEs as bs
  | _, _ => false

def beqEs : List Expr → List Expr → Bool
  | [], [] => true
  | a :: as, b :: bs => beqE a b && beqEs as bs
  | _, _ => false
end

mutual
def beqS : Stmt → Stmt → Bool
  | .block a, .block b => beqL a b
  | .letv xs e, .letv ys f => xs == ys && beqE e f
  | .assign x e, .assign y f => x == y && beqE e f
  | .ifs c a, .ifs d b => beqE c d && beqL a b
  | .switch c a, .switch d b => beqE c d && beqL a b
  | .arm k a, .arm l b => k == l && beqL a b
  | .exprStmt e, .exprStmt f => beqE e f
  | .funDef f ps rs a, .funDef g qs ts b => f == g && ps == qs && rs == ts && beqL a b
  | _, _ => false

def beqL : List Stmt → List Stmt → Bool
  | [], [] => true
  | a :: as, b :: bs => beqS a b && beqL as bs
  | _, _ => false
end

mutual
theorem beqE_eq : ∀ a b : Expr, beqE a b = true → a = b
  | .lit _, .lit _, h => by simp only [beqE, beq_iff_eq] at h; rw [h]
  | .var _, .var _, h => by simp only [beqE, beq_iff_eq] at h; rw [h]
  | .call f as, .call g bs, h => by
    simp only [beqE, Bool.and_eq_true, beq_iff_eq] at h
    rw [h.1, beqEs_eq as bs h.2]
  | .lit _, .var _, h | .lit _, .call _ _, h | .var _, .lit _, h | .var _, .call _ _, h
  | .call _ _, .lit _, h | .call _ _, .var _, h => by simp [beqE] at h

theorem beqEs_eq : ∀ a b : List Expr, beqEs a b = true → a = b
  | [], [], _ => rfl
  | a :: as, b :: bs, h => by
    simp only [beqEs, Bool.and_eq_true] at h
    rw [beqE_eq a b h.1, beqEs_eq as bs h.2]
  | [], _ :: _, h | _ :: _, [], h => by simp [beqEs] at h
end

mutual
theorem beqS_eq : ∀ a b : Stmt, beqS a b = true → a = b
  | .block a, .block b, h => by simp only [beqS] at h; rw [beqL_eq a b h]
  | .letv xs e, .letv ys f, h => by
    simp only [beqS, Bool.and_eq_true, beq_iff_eq] at h; rw [h.1, beqE_eq e f h.2]
  | .assign x e, .assign y f, h => by
    simp only [beqS, Bool.and_eq_true, beq_iff_eq] at h; rw [h.1, beqE_eq e f h.2]
  | .ifs c a, .ifs d b, h => by
    simp only [beqS, Bool.and_eq_true] at h; rw [beqE_eq c d h.1, beqL_eq a b h.2]
  | .switch c a, .switch d b, h => by
    simp only [beqS, Bool.and_eq_true] at h; rw [beqE_eq c d h.1, beqL_eq a b h.2]
  | .arm k a, .arm l b, h => by
    simp only [beqS, Bool.and_eq_true, beq_iff_eq] at h; rw [h.1, beqL_eq a b h.2]
  | .exprStmt e, .exprStmt f, h => by simp only [beqS] at h; rw [beqE_eq e f h]
  | .funDef f ps rs a, .funDef g qs ts b, h => by
    simp only [beqS, Bool.and_eq_true, beq_iff_eq] at h
    rw [h.1.1.1, h.1.1.2, h.1.2, beqL_eq a b h.2]
  | .block _, .letv _ _, h | .block _, .assign _ _, h | .block _, .ifs _ _, h
  | .block _, .switch _ _, h | .block _, .arm _ _, h | .block _, .exprStmt _, h
  | .block _, .funDef _ _ _ _, h
  | .letv _ _, .block _, h | .letv _ _, .assign _ _, h | .letv _ _, .ifs _ _, h
  | .letv _ _, .switch _ _, h | .letv _ _, .arm _ _, h | .letv _ _, .exprStmt _, h
  | .letv _ _, .funDef _ _ _ _, h
  | .assign _ _, .block _, h | .assign _ _, .letv _ _, h | .assign _ _, .ifs _ _, h
  | .assign _ _, .switch _ _, h | .assign _ _, .arm _ _, h | .assign _ _, .exprStmt _, h
  | .assign _ _, .funDef _ _ _ _, h
  | .ifs _ _, .block _, h | .ifs _ _, .letv _ _, h | .ifs _ _, .assign _ _, h
  | .ifs _ _, .switch _ _, h | .ifs _ _, .arm _ _, h | .ifs _ _, .exprStmt _, h
  | .ifs _ _, .funDef _ _ _ _, h
  | .switch _ _, .block _, h | .switch _ _, .letv _ _, h | .switch _ _, .assign _ _, h
  | .switch _ _, .ifs _ _, h | .switch _ _, .arm _ _, h | .switch _ _, .exprStmt _, h
  | .switch _ _, .funDef _ _ _ _, h
  | .arm _ _, .block _, h | .arm _ _, .letv _ _, h | .arm _ _, .assign _ _, h
  | .arm _ _, .ifs _ _, h | .arm _ _, .switch _ _, h | .arm _ _, .exprStmt _, h
  | .arm _ _, .funDef _ _ _ _, h
  | .exprStmt _, .block _, h | .exprStmt _, .letv _ _, h | .exprStmt _, .assign _ _, h
  | .exprStmt _, .ifs _ _, h | .exprStmt _, .switch _ _, h | .exprStmt _, .arm _ _, h
  | .exprStmt _, .funDef _ _ _ _, h
  | .funDef _ _ _ _, .block _, h | .funDef _ _ _ _, .letv _ _, h
  | .funDef _ _ _ _, .assign _ _, h | .funDef _ _ _ _, .ifs _ _, h
  | .funDef _ _ _ _, .switch _ _, h | .funDef _ _ _ _, .arm _ _, h
  | .funDef _ _ _ _, .exprStmt _, h => by simp [beqS] at h

theorem beqL_eq : ∀ a b : List Stmt, beqL a b = true → a = b
  | [], [], _ => rfl
  | a :: as, b :: bs, h => by
    simp only [beqL, Bool.and_eq_true] at h
    rw [beqS_eq a b h.1, beqL_eq as bs h.2]
  | [], _ :: _, h | _ :: _, [], h => by simp [beqL] at h
end

/-! ## The expected statements -/

def revert00 : Stmt := .exprStmt (.call "revert" [.lit 0, .lit 0])

/-- `if lt(calldatasize(), 4) { revert(0, 0) }` -/
def ifShort : Stmt := .ifs (.call "lt" [.call "calldatasize" [], .lit 4]) [revert00]

/-- The `compress` arm. -/
def caseBody : List Stmt :=
  [.ifs (.call "slt" [.call "sub" [.call "calldatasize" [], .lit 4], .lit 96]) [revert00],
   .letv ["out0", "out1", "out2"]
     (.call "permute" [.call "calldataload" [.lit 4], .call "calldataload" [.lit 36],
       .call "calldataload" [.lit 68]]),
   .exprStmt (.call "mstore" [.lit 0, .var "out1"]),
   .exprStmt (.call "return" [.lit 0, .lit 32])]

/-- The selector of `compress(uint256,uint256,uint256)`. -/
def compressSelector : ℕ := 0x2d0c7694

/-- `switch shr(224, calldataload(0)) case 0x2d0c7694 { … } default { revert(0, 0) }` -/
def dispatch : Stmt :=
  .switch (.call "shr" [.lit 224, .call "calldataload" [.lit 0]])
    [.arm (some compressSelector) caseBody, .arm none [revert00]]

/-- The end of `permute`'s body. -/
def retTail : List Stmt := [.assign "r0" (.var "s0"), .assign "r1" (.var "s1"), .assign "r2" (.var "s2")]

/-- The names visible in `permute`'s rounds: the modulus, the parameters, the return variables. -/
def fnNames : List String := ["P", "s0", "s1", "s2", "r0", "r1", "r2"]

/-- What the kernel checks on the fallback's assembly block. -/
def pocOK (toks : List Tok) : Bool :=
  match parseBody toks with
  | some [.funDef f ps rs body, s1, s2] =>
    f == "permute" && ps == ["s0", "s1", "s2"] && rs == ["r0", "r1", "r2"] &&
      beqS s1 ifShort && beqS s2 dispatch && beqL (body.drop (body.length - 3)) retTail &&
      match unembL (body.take (body.length - 3)) with
      | some (h0 :: h1 :: rs') =>
        Yul.Frag.headOK [h0, h1] && Yul.Frag.flatL rs' == some program && Yul.Frag.wsL fnNames rs' == some fnNames
      | _ => false
  | _ => false

theorem pocOK_spec {toks : List Tok} (h : pocOK toks = true) :
    ∃ pre rs', parseBody toks =
        some [.funDef "permute" ["s0", "s1", "s2"] ["r0", "r1", "r2"] (pre ++ retTail), ifShort, dispatch] ∧
      unembL pre = some (Yul.Frag.headP :: Yul.Frag.headIf :: rs') ∧ Yul.Frag.flatL rs' = some program ∧
      Yul.Frag.wsL fnNames rs' = some fnNames := by
  unfold pocOK at h
  split at h
  · rename_i f ps rs body s1 s2 hp
    simp only [Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨⟨⟨⟨⟨rfl, rfl⟩, rfl⟩, h1⟩, h2⟩, h3⟩, h4⟩ := h
    split at h4
    · rename_i h0 h1' rs' hu
      simp only [Bool.and_eq_true, beq_iff_eq] at h4
      obtain ⟨⟨hh, hf⟩, hw⟩ := h4
      obtain ⟨rfl, rfl⟩ := Yul.Frag.headOK_spec hh
      have ht := beqL_eq _ _ h3
      refine ⟨body.take (body.length - 3), rs', ?_, hu, hf, hw⟩
      rw [hp, beqS_eq _ _ h1, beqS_eq _ _ h2, ← ht, List.take_append_drop]
    · cases h4
  · cases h

set_option maxRecDepth 100000 in
/-- **The kernel parses the PoC's assembly block** and finds `permute` (the runtime's body),
the length check and the dispatcher. -/
theorem pocOK_source : pocOK Data.fallbackBody = true := by decide +kernel

/-! ## `permute` -/

theorem execL_append (ctx : Ctx) (fs : Funs) (st : St) (xs ys : List Stmt) :
    execL ctx fs st (xs ++ ys) =
      match execL ctx fs st xs with
      | some (.inr (st', fs')) => execL ctx fs' st' ys
      | o => o := by
  induction xs generalizing fs st with
  | nil => simp [execL]
  | cons x xs ih =>
    simp only [List.cons_append, execL]
    cases h : execS ctx fs st x with
    | none => rfl
    | some o =>
      cases o with
      | inl hh => rfl
      | inr p => exact ih p.2 p.1

theorem names_seven {σ : Yul.Scope} {n₁ n₂ n₃ n₄ n₅ n₆ n₇ : String}
    (h : Yul.Scope.names σ = [n₁, n₂, n₃, n₄, n₅, n₆, n₇]) :
    ∃ v₁ v₂ v₃ v₄ v₅ v₆ v₇, σ = [(n₁, v₁), (n₂, v₂), (n₃, v₃), (n₄, v₄), (n₅, v₅), (n₆, v₆), (n₇, v₇)] := by
  match σ, h with
  | [(_, v₁), (_, v₂), (_, v₃), (_, v₄), (_, v₅), (_, v₆), (_, v₇)], h =>
    simp only [Yul.Scope.names, List.map_cons, List.map_nil, List.cons.injEq] at h
    obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, -⟩ := h
    exact ⟨v₁, v₂, v₃, v₄, v₅, v₆, v₇, rfl⟩

/-- `permute`'s body, from the call's fresh scope: the rounds leave `wordPermute` in
`s0 s1 s2` (the `Zkapi.Yul` proof), and the tail copies them to `r0 r1 r2`. -/
theorem permute_body (ctx : Ctx) (hlen : ctx.calldata.length ≤ 0xffffffffffff) {pre : List Stmt}
    {rs' : List Yul.Frag.Stmt} (hu : unembL pre = some (Yul.Frag.headP :: Yul.Frag.headIf :: rs'))
    (hf : Yul.Frag.flatL rs' = some program) (hw : Yul.Frag.wsL fnNames rs' = some fnNames) (a b c : ℕ)
    (m : Mem) :
    ∃ σ, execL ctx [] ⟨[("s0", a), ("s1", b), ("s2", c), ("r0", 0), ("r1", 0), ("r2", 0)], m⟩
        (pre ++ retTail) = some (.inr (⟨σ, m⟩, [])) ∧
      results σ ["r0", "r1", "r2"] =
        some [(wordPermute a b c).1, (wordPermute a b c).2.1, (wordPermute a b c).2.2] := by
  set σ₀ : Yul.Scope := [("s0", a), ("s1", b), ("s2", c), ("r0", 0), ("r1", 0), ("r2", 0)]
  set σ₁ : Yul.Scope := ("P", Zkapi.p) :: σ₀
  set cx : Yul.Frag.Ctx := ⟨ctx.calldata.length⟩
  have h0 : Yul.Frag.execS cx σ₀ Yul.Frag.headP = some σ₁ := by
    simp [Yul.Frag.execS, Yul.Frag.headP, Yul.Frag.evalE, Yul.Scope.lookup, σ₀, σ₁]
  have h1 : Yul.Frag.execS cx σ₁ Yul.Frag.headIf = some σ₁ := by
    have : ¬ (0xffffffffffff < ctx.calldata.length) := by omega
    simp [Yul.Frag.execS, Yul.Frag.headIf, Yul.Frag.evalE, Yul.Frag.evalArgs, Yul.Frag.builtin, cx, this]
  have hA : Yul.Frag.Agree σ₁ (Zkapi.Lazy.initEnv a b c) := by
    intro x v hx
    simp only [σ₁, σ₀, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at hx
    rcases hx with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
      ⟨rfl, rfl⟩
    · exact ⟨fun _ => rfl, fun u hu => absurd hu.symm (Yul.Frag.name_ne_P u)⟩
    all_goals
      refine ⟨fun h => absurd h (by decide), fun u hu => ?_⟩
      cases u <;> first | rfl | exact absurd hu (by decide)
  have hn : (Yul.Scope.names σ₁).Nodup := by simp [σ₁, σ₀, Yul.Scope.names]
  have hnames : Yul.Scope.names σ₁ = fnNames := rfl
  obtain ⟨σ₂, e2, n2, -, a2⟩ :=
    Yul.Frag.execL_flat cx rs' σ₁ (Zkapi.Lazy.initEnv a b c) program fnNames hf (hnames ▸ hw) hn hA
  obtain ⟨v₁, v₂, v₃, v₄, v₅, v₆, v₇, rfl⟩ := names_seven n2
  have g (x : String) (u : Zkapi.Lazy.Var) (v : ℕ)
      (hm : (x, v) ∈ [("P", v₁), ("s0", v₂), ("s1", v₃), ("s2", v₄), ("r0", v₅), ("r1", v₆),
        ("r2", v₇)]) (hu : x = u.name) :
      v = Zkapi.Lazy.exec program (Zkapi.Lazy.initEnv a b c) u := (a2 x v hm).2 u hu
  have g2 := g "s0" .s0 v₂ (by simp) rfl
  have g3 := g "s1" .s1 v₃ (by simp) rfl
  have g4 := g "s2" .s2 v₄ (by simp) rfl
  have hpre : Yul.Frag.execL cx σ₀ (Yul.Frag.headP :: Yul.Frag.headIf :: rs') =
      some [("P", v₁), ("s0", v₂), ("s1", v₃), ("s2", v₄), ("r0", v₅), ("r1", v₆), ("r2", v₇)] := by
    simp only [Yul.Frag.execL, h0, h1, e2]
  have hpoc := execL_unemb ctx pre _ σ₀ _ m hu hpre
  refine ⟨[("P", v₁), ("s0", v₂), ("s1", v₃), ("s2", v₄), ("r0", v₂), ("r1", v₃), ("r2", v₄)], ?_, ?_⟩
  · rw [execL_append, hpoc]
    simp [retTail, execL, execS, rhs, evalE, Yul.Scope.lookup, Yul.Scope.set]
  · simp [results, Yul.Scope.lookup, g2, g3, g4, wordPermute]

/-! ## The entry point -/

/-- The 32-byte big-endian encoding of a word. -/
def be32 (v : ℕ) : List ℕ := (List.range 32).map fun k => v / 256 ^ (31 - k) % 256

/-- `calldataload(i)`: the 32 calldata bytes at `i`, big-endian, zero past the end. -/
def cdWord (cd : List ℕ) (i : ℕ) : ℕ := word32 (cdByte cd) i

/-- What the fallback must do with calldata `cd`. -/
def compressSpec (cd : List ℕ) : Halt :=
  if cd.length < 4 then .rev []
  else if cdWord cd 0 / 2 ^ 224 = compressSelector then
    if cd.length < 4 + 96 then .rev []
    else .ret (be32 (compressWord (cdWord cd 4) (cdWord cd 36) (cdWord cd 68)))
  else .rev []

/-- The parsed assembly block of `PoseidonFallback.sol`. -/
def fallbackAst : List Stmt := (parseBody Data.fallbackBody).getD []

theorem bytesOf_mstore (m : Mem) (v : ℕ) : bytesOf (mstore m 0 v) 0 32 = be32 v := by
  simp only [bytesOf, be32, mstore]
  apply List.map_congr_left
  intro k hk
  have : k < 32 := List.mem_range.1 hk
  simp [this]

theorem revert00_spec (ctx : Ctx) (fs : Funs) (st : St) :
    execS ctx fs st revert00 = some (.inl (.rev [])) := by
  simp [revert00, execS, evalArgs, evalE, bytesOf]

theorem toInt_small {a : ℕ} (h : a < 2 ^ 255) : toInt a = a := by
  unfold toInt
  split
  · rfl
  · contradiction

/-- The meaning `funDef` gives `permute`. -/
def permFn (ctx : Ctx) (body : List Stmt) : Fn := fun vs m =>
  match frame ["s0", "s1", "s2"] ["r0", "r1", "r2"] vs with
  | none => none
  | some σ =>
    match execL ctx [] ⟨σ, m⟩ body with
    | some (.inr (st', _)) => (results st'.scope ["r0", "r1", "r2"]).map fun outs => .inr (outs, st'.mem)
    | some (.inl h) => some (.inl h)
    | none => none

theorem exec_funDef (ctx : Ctx) (m : Mem) (body : List Stmt) :
    execS ctx [] ⟨[], m⟩ (.funDef "permute" ["s0", "s1", "s2"] ["r0", "r1", "r2"] body) =
      some (.inr (⟨[], m⟩, [("permute", permFn ctx body)])) := rfl

theorem exec_ifShort (ctx : Ctx) (fs : Funs) (st : St) :
    execS ctx fs st ifShort =
      if ctx.calldata.length < 4 then some (.inl (.rev [])) else some (.inr (st, fs)) := by
  by_cases h : ctx.calldata.length < 4
  · simp [ifShort, execS, evalE, evalArgs, builtin, h, execL, revert00_spec, closeBlock]
  · simp [ifShort, execS, evalE, evalArgs, builtin, h]

/-- `sub(calldatasize(), 4)` and `slt(·, 96)` on calldata of `4` to `2^48` bytes. -/
theorem short_check (n : ℕ) (h4 : 4 ≤ n) (hn : n ≤ 0xffffffffffff) :
    (n + (Zkapi.Lazy.W - 4 % Zkapi.Lazy.W)) % Zkapi.Lazy.W = n - 4 ∧
      (if toInt (n - 4) < toInt 96 then 1 else 0) = (if n < 100 then 1 else 0) := by
  have hW : (Zkapi.Lazy.W : ℕ) = 2 ^ 256 := rfl
  refine ⟨?_, ?_⟩
  · rw [hW, show (4 : ℕ) % 2 ^ 256 = 4 by norm_num]
    rw [show n + (2 ^ 256 - 4) = (n - 4) + 2 ^ 256 by omega, Nat.add_mod_right,
      Nat.mod_eq_of_lt (by omega)]
  · rw [toInt_small (show n - 4 < 2 ^ 255 by omega), toInt_small (show (96 : ℕ) < 2 ^ 255 by norm_num)]
    by_cases h : n < 100
    · simp [h, show n - 4 < 96 by omega]
    · simp [h, show ¬ (n - 4 < 96) by omega]

theorem execArms_case (ctx : Ctx) (fs : Funs) (st : St) (v k : ℕ) (body arms : List Stmt) :
    execArms ctx fs st v (.arm (some k) body :: arms) =
      if k = v then closeBlock st fs (execL ctx fs st body) else execArms ctx fs st v arms := by
  rw [execArms]

theorem execArms_default (ctx : Ctx) (fs : Funs) (st : St) (v : ℕ) (body arms : List Stmt) :
    execArms ctx fs st v (.arm none body :: arms) = closeBlock st fs (execL ctx fs st body) := by
  rw [execArms]

theorem execS_switch (ctx : Ctx) (fs : Funs) (st : St) (c : Expr) (arms : List Stmt) (v : ℕ)
    (h : evalE ctx st.mem st.scope c = some v) :
    execS ctx fs st (.switch c arms) = execArms ctx fs st v arms := by
  rw [execS, h]

/-- The dispatcher. (Generic lemmas, instantiated by `rw`: unfolding the semantics on the concrete
`switch` makes the kernel reduce the selector literal.) -/
theorem exec_dispatch (ctx : Ctx) (fs : Funs) (st : St) :
    execS ctx fs st dispatch =
      if compressSelector = cdWord ctx.calldata 0 / 2 ^ 224 then
        closeBlock st fs (execL ctx fs st caseBody)
      else some (.inl (.rev [])) := by
  have h224 : (224 : ℕ) < 256 := by norm_num
  have he : evalE ctx st.mem st.scope (.call "shr" [.lit 224, .call "calldataload" [.lit 0]]) =
      some (cdWord ctx.calldata 0 / 2 ^ 224) := by
    simp only [evalE, evalArgs, builtin, h224, ite_true, cdWord]
  rw [dispatch, execS_switch ctx fs st _ _ _ he, execArms_case, execArms_default]
  split_ifs
  · rfl
  · simp only [closeBlock, execL, revert00_spec]

/-- The `compress` arm, with `permute` meaning `F`. -/
theorem exec_case (ctx : Ctx) (F : Fn) (m : Mem) (o₀ o₁ o₂ : ℕ)
    (hF : F [cdWord ctx.calldata 4, cdWord ctx.calldata 36, cdWord ctx.calldata 68] m =
      some (.inr ([o₀, o₁, o₂], m)))
    (h4 : 4 ≤ ctx.calldata.length) (hlen : ctx.calldata.length ≤ 0xffffffffffff) :
    execL ctx [("permute", F)] ⟨[], m⟩ caseBody =
      if ctx.calldata.length < 100 then some (.inl (.rev [])) else some (.inl (.ret (be32 o₁))) := by
  obtain ⟨hsub, hslt⟩ := short_check ctx.calldata.length h4 hlen
  have hif : execS ctx [("permute", F)] ⟨[], m⟩
      (.ifs (.call "slt" [.call "sub" [.call "calldatasize" [], .lit 4], .lit 96]) [revert00]) =
      if ctx.calldata.length < 100 then some (.inl (.rev [])) else some (.inr (⟨[], m⟩, [("permute", F)])) := by
    simp only [execS, evalE, evalArgs, builtin, hsub, hslt]
    split_ifs with h
    · simp only [closeBlock, execL, revert00_spec]
    · rfl
  simp only [caseBody, execL, hif]
  split_ifs with h
  · rfl
  · have hF' : F [word32 (cdByte ctx.calldata) 4, word32 (cdByte ctx.calldata) 36,
        word32 (cdByte ctx.calldata) 68] m = some (.inr ([o₀, o₁, o₂], m)) := hF
    simp only [execS, rhs, Funs.find, ite_true, evalArgs, evalE, builtin, hF', declare,
      Yul.Scope.lookup, Option.isSome_none, Bool.false_eq_true, ite_false]
    simp [Yul.Scope.lookup, bytesOf_mstore]

/-- **`compress` end to end.** For every calldata `cd` shorter than `2^48` bytes and every initial
memory, the fallback's assembly block halts as `compressSpec cd` says: `revert(0, 0)` on short
calldata or an unknown selector, otherwise `return` of the big-endian word
`compressWord w₄ w₃₆ w₆₈` (`= (Poseidon.compress w₄ w₃₆ w₆₈).val`, `compressWord_eq`). -/
theorem poc_compress (cd : List ℕ) (hlen : cd.length ≤ 0xffffffffffff) (m : Mem) :
    run ⟨cd⟩ m fallbackAst = some (.inl (compressSpec cd)) := by
  obtain ⟨pre, rs', hp, hu, hf, hw⟩ := pocOK_spec pocOK_source
  have hast : fallbackAst =
      [.funDef "permute" ["s0", "s1", "s2"] ["r0", "r1", "r2"] (pre ++ retTail), ifShort, dispatch] := by
    simp only [fallbackAst, hp, Option.getD_some]
  rw [hast]
  obtain ⟨σ, hbody, hres⟩ :=
    permute_body ⟨cd⟩ hlen hu hf hw (cdWord cd 4) (cdWord cd 36) (cdWord cd 68) m
  have hF : permFn ⟨cd⟩ (pre ++ retTail) [cdWord cd 4, cdWord cd 36, cdWord cd 68] m =
      some (.inr ([(wordPermute (cdWord cd 4) (cdWord cd 36) (cdWord cd 68)).1,
        (wordPermute (cdWord cd 4) (cdWord cd 36) (cdWord cd 68)).2.1,
        (wordPermute (cdWord cd 4) (cdWord cd 36) (cdWord cd 68)).2.2], m)) := by
    simp only [permFn, frame, List.length_cons, List.length_nil, ite_true, List.zip_cons_cons,
      List.zip_nil_right, List.map_cons, List.map_nil, List.cons_append, List.nil_append, hbody,
      hres, Option.map_some]
  simp only [run, execL, exec_funDef, exec_ifShort]
  unfold compressSpec
  by_cases h4 : cd.length < 4
  · simp only [h4, ite_true]
  · simp only [h4, ite_false, exec_dispatch]
    by_cases hs : compressSelector = cdWord cd 0 / 2 ^ 224
    · simp only [hs, ite_true, exec_case ⟨cd⟩ _ m _ _ _ hF (show 4 ≤ cd.length by omega) hlen]
      by_cases h100 : cd.length < 100
      · simp only [h100, ite_true, closeBlock]
      · simp only [h100, ite_false, closeBlock, compressWord]
    · simp only [hs, ite_false, Ne.symm hs]

/-- With the selector and at least `4 + 96` bytes, the returned word is zkAPI's `compress` of the
three calldata words reduced mod p, for all words. -/
theorem poc_compress_reference (cd : List ℕ) (hlen : cd.length ≤ 0xffffffffffff) (m : Mem)
    (hsel : cdWord cd 0 / 2 ^ 224 = compressSelector) (h100 : 4 + 96 ≤ cd.length) :
    run ⟨cd⟩ m fallbackAst = some (.inl (.ret (be32
      (Poseidon.compress (cdWord cd 4 : F) (cdWord cd 36 : F) (cdWord cd 68 : F)).val))) := by
  rw [poc_compress cd hlen m, compressSpec]
  split_ifs with h1 h2
  · omega
  · omega
  · rw [Zkapi.Lazy.compressWord_eq]

/-! ## Known answers: the kernel runs the parsed block -/

/-- The halt, if any. -/
def haltOf : Option Out → Option Halt
  | some (.inl h) => some h
  | _ => none

/-- 32 bytes, big-endian. -/
def bytes32 (v : ℕ) : List ℕ := be32 v

/-- `compress(DOMAIN_NODE, 1, 2)` as calldata. -/
def nodeCalldata : List ℕ :=
  [0x2d, 0x0c, 0x76, 0x94] ++ bytes32 0x7a6b6170692e76322e6e6f6465 ++ bytes32 1 ++ bytes32 2

set_option maxRecDepth 100000 in
theorem poc_vector_compress :
    haltOf (run ⟨nodeCalldata⟩ (fun _ => 0) fallbackAst) =
      some (.ret (be32 0x178f4ab3e9e68f4c3459db1c927c9abd074ba5079d8d972e6594b07a5ab1c3b1)) := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem poc_vector_short :
    haltOf (run ⟨nodeCalldata.take 99⟩ (fun _ => 0) fallbackAst) = some (.rev []) := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem poc_vector_selector :
    haltOf (run ⟨[0x2d, 0x0c, 0x76, 0x95] ++ nodeCalldata.drop 4⟩ (fun _ => 0) fallbackAst) =
      some (.rev []) := by
  decide +kernel

end Zkapi.PoC
